# Telegraph node, testnet per docs.telegraphprotocol.com
TELEGRAPH_API_BASE=https://devnode.telegraphprotocol.com

# Payer wallet for x402 USDC payments, server side only, never exposed
# Fund it with Base Sepolia testnet USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
WALLET_PRIVATE_KEY=

# Optional miner id overrides, resolved from /api/miners by default
TELEGRAPH_MINER_ID_WEB=
TELEGRAPH_MINER_ID_REASONING=
TELEGRAPH_MINER_ID_MEDIA=

# Network flag for the demo, true means Base Sepolia testnet
NEXT_PUBLIC_USE_TESTNET=true
